rules_version = '2';

// ---------------------------------------------------------------------------
// /kyiv1/{doc} requires a signed-in Firebase user. Anonymous auth is enabled
// for the project and index.html signs every visitor in automatically
// (ensureFirebaseAuth(), before any Firestore call) — no credentials asked,
// no change to the app's own login screen. This blocks a bare, tokenless
// call to the Firestore REST API (how this data was reachable before); the
// app's own login screen (per-store / District Manager password, now
// stored as salted+hashed credentials — see makeCredential/verifyCredential
// in index.html) is a second, independent layer on top of this, still
// enforced only in client-side JS, not by this rule.
//
// This finished a two-phase hardening (Adam asked, 2026-09-15, for the site
// to be protected against outside access). Phase 1 moved the TELEGRAM BOT's
// own data (below) behind a service account. Phase 2 (this rule) added
// Firebase Authentication for the dashboard itself.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /kyiv1/{doc} {
      allow read, write: if request.auth != null;
    }
    // State for the Telegram bot (telegram-bot/worker.js): per-chat
    // activity stats, points, store links, reports, birthdays, reminders,
    // plus a small index of chat IDs the bot is active in.
    //
    // LOCKED — not the same open trade-off as /kyiv1 above. The bot now
    // authenticates its own Firestore access as a Firebase service account
    // (env.FIREBASE_SERVICE_ACCOUNT_KEY in worker.js, see
    // getGoogleAccessToken/firestoreGetRaw there and the secret's own
    // comment in wrangler.toml) — a service account with IAM access to
    // Firestore bypasses Security Rules by design (the same mechanism the
    // Admin SDK uses), so `allow ... if false` below blocks every other
    // caller — literally anyone hitting the Firestore REST API directly,
    // which is exactly how this data was exposed before — while the bot
    // itself keeps working unaffected.
    match /telegram-bot/{doc} {
      allow read, write: if false;
    }
  }
}
