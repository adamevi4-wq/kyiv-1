rules_version = '2';

// ---------------------------------------------------------------------------
// These rules make every document under /kyiv1/{doc} publicly readable and
// writable by anyone who has the Firestore project config (which ships
// inside the app's public JS bundle — see index.html — this is not a
// secret, every Firebase web app exposes it this way).
//
// Real access control here is the app's own login screen (per-store
// password = store code, District Manager password = a separate shared
// password) — but that check happens in client-side JavaScript, not in
// these rules. Anyone who reads the page's source (or opens the browser
// devtools network tab) can see and change the underlying data directly,
// bypassing the login screen entirely. That's an accepted trade-off for a
// small internal tool with no paid backend — do not put anything here you
// wouldn't want a determined visitor to see or edit.
//
// This is Phase 1 of a two-phase security hardening (Adam asked, 2026-09-15,
// for the bot to be protected against outside access). Phase 1 (done, this
// file) moved the TELEGRAM BOT's own data (below) behind a service account —
// its stakes are higher than this dashboard blob, since it's live
// operational state (points, store links, birthday data), not just a
// read-mostly display. Phase 2 (not done yet) gives the DASHBOARD real
// per-person Firebase Authentication accounts instead of the client-side
// store-code check, at which point this rule becomes
// `allow read, write: if request.auth != null;` too. Until then, do not put
// anything here you wouldn't want a determined visitor to see or edit.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /kyiv1/{doc} {
      allow read, write: if true;
    }
    // State for the Telegram bot (telegram-bot/worker.js): per-chat
    // activity stats, points, store links, reports, birthdays, reminders,
    // plus a small index of chat IDs the bot is active in.
    //
    // LOCKED — not the same open trade-off as /kyiv1 above. The bot now
    // authenticates its own Firestore access as a Firebase service account
    // (env.FIREBASE_SERVICE_ACCOUNT_KEY in worker.js, see
    // getGoogleAccessToken/firestoreGetRaw there and the secret's own
    // comment in wrangler.toml) — a service account with IAM access to
    // Firestore bypasses Security Rules by design (the same mechanism the
    // Admin SDK uses), so `allow ... if false` below blocks every other
    // caller — literally anyone hitting the Firestore REST API directly,
    // which is exactly how this data was exposed before — while the bot
    // itself keeps working unaffected.
    match /telegram-bot/{doc} {
      allow read, write: if false;
    }
  }
}
